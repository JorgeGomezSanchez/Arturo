# ------------------------------------------------------------
# Arturo backend configuration
# Copy this file to ".env" (in this same folder) and adjust it.
# Every variable is optional: if missing, the defaults shown here
# are used.
# ------------------------------------------------------------

# Allowed CORS origins (comma separated). Only needed if the frontend is
# served from another origin without the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
