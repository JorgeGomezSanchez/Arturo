# ------------------------------------------------------------
# Arturo backend configuration
# Copy this file to ".env" (in this same folder) and adjust it.
# Every variable is optional: if missing, the defaults shown here
# are used.
# ------------------------------------------------------------

# Allowed CORS origins (comma separated). Only needed if the frontend is
# served from another origin without the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------
# DATA SOURCE — the Earth <-> Mars switch (the frontend never changes)
#   remote : Earth mode. Tiles are downloaded from NASA Mars Trek / Esri
#            and saved to the disk cache.
#   local  : Mars mode. Tiles are read only from LOCAL_TILES_DIR. Zero network.
# ---------------------------------------------------------------
DATA_SOURCE=remote

# Folder with offline tile packs (layout: {layer}/{z}/{x}/{y}.{ext})
LOCAL_TILES_DIR=./data/tiles

# Disk cache for remote mode (same layout => it doubles as an offline pack)
TILE_CACHE_ENABLED=true
TILE_CACHE_DIR=./cache/tiles

# HTTP client for remote mode
REMOTE_TIMEOUT_S=15
REMOTE_USER_AGENT=Arturo/0.1 (NASA Space Apps 2026 project)
