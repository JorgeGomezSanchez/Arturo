# ------------------------------------------------------------
# Arturo backend configuration
# Copy this file to ".env" (in this same folder) and adjust it.
# Every variable is optional: if missing, the defaults shown here
# are used.
# ------------------------------------------------------------

# Allowed CORS origins (comma separated). Only needed if the frontend is
# served from another origin without the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------
# DATA SOURCE — the Earth <-> Mars switch (the frontend never changes)
#   remote : Earth mode. Tiles are downloaded from NASA Mars Trek / Esri
#            and saved to the disk cache.
#   local  : Mars mode. Tiles are read only from LOCAL_TILES_DIR. Zero network.
# ---------------------------------------------------------------
DATA_SOURCE=remote

# Folder with offline tile packs (layout: {layer}/{z}/{x}/{y}.{ext})
LOCAL_TILES_DIR=./data/tiles

# Disk cache for remote mode (same layout => it doubles as an offline pack)
TILE_CACHE_ENABLED=true
TILE_CACHE_DIR=./cache/tiles

# HTTP client for remote mode
REMOTE_TIMEOUT_S=15
REMOTE_USER_AGENT=Arturo/0.1 (NASA Space Apps 2026 project)

# ---------------------------------------------------------------
# NAMED FEATURES (map labels): folder with *.geojson (committed to
# the repo; read from disk in both modes, works offline)
# ---------------------------------------------------------------
FEATURES_DIR=./data/features

# ---------------------------------------------------------------
# USER POIs storage
#   json   : one JSON file (POI_STORE_FILE). Survives restarts.
#   memory : RAM only, lost on restart (tests / throwaway demos)
# ---------------------------------------------------------------
POI_STORE=json
POI_STORE_FILE=./data/pois/pois.json

# ---------------------------------------------------------------
# POINT QUERIES (GET /api/point): numeric GeoTIFFs for exact values
#   RASTERS_DIR      : compact GeoTIFFs (committed; extra ones are built
#                      with `python -m scripts.build_rasters`)
#   POINT_REMOTE_DEM : Earth mode only. Read the USGS 200 m HRSC+MOLA DEM
#                      live over HTTP range requests where no local 200 m
#                      crop exists (falls back to the 463 m MOLA grid).
#                      Ignored in Mars mode (DATA_SOURCE=local).
# ---------------------------------------------------------------
RASTERS_DIR=./data/rasters
POINT_REMOTE_DEM=true
POINT_REMOTE_TIMEOUT_S=8
