# ------------------------------------------------------------
# Arturo frontend configuration (Vite)
# Copy to ".env.local" and adjust. Variables must start with VITE_
# to be visible in the browser code.
# ------------------------------------------------------------

# Backend base URL as seen by the BROWSER.
#   Empty (default) -> same origin: in development the Vite proxy
#   forwards /api to the backend, so you don't need to set anything.
#   Set it only if the backend lives elsewhere, e.g.
#   VITE_API_URL=http://192.168.1.50:8000
VITE_API_URL=

# Where the Vite DEV SERVER proxies /api (development only).
VITE_DEV_BACKEND=http://127.0.0.1:8000
